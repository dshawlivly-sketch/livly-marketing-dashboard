# Copy to .env for local dev, or set these in Vercel > Settings > Environment Variables.
# Keys stay server-side; the browser never sees them.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# OpenDesign (https://github.com/nexu-io/open-design) — point at your deployed instance
OPENDESIGN_BASE_URL=https://your-open-design-instance.example.com
OPENDESIGN_API_KEY=
# Optional: override the generate endpoint path (default /api/generate)
OPENDESIGN_GENERATE_PATH=/api/generate
